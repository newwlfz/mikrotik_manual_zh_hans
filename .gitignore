# Dependencies and build output
node_modules/
build/
.docusaurus/
.cache-loader/

# The local workflow may symlink the English checkout's dependencies:
# `ln -s ../repo_en/node_modules node_modules`. A trailing slash only matches a
# real directory, so ignore the symlink too.
/node_modules

# ...but `build/` above matches at any depth and would also swallow the build
# *tooling* under tools/build/, which is source: `npm run build` runs
# `node tools/build/index.mjs`. Keep the site output ignored, track the tooling.
!tools/build/
!tools/build/**

# Local environment and secrets. `.env.local` is the file the translation
# tools read (see guides/LLM.md); the examples are templates, not secrets.
.env
.env.*
.env.local
.env.*.local
!.env.example
!.env.local.example

# Logs and browser artefacts
*.log
playwright-report/
test-results/
blob-report/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
.work/

.generated/

# Live-navigation crawl cache (regenerated by `npm run sidebar:crawl`).
data/nav/

# Local scratch (crawl/debug artefacts).
work/

# Per-run journal of `npm run sync -- --update`; regenerated on every run.
state/update-run.json

# Content: neither authored nor versioned here. `npm run content:fetch` copies
# it from the hub content release (locally: a sibling `repo_en` checkout); every
# path below is produced upstream. The translation memory under `work/translate`
# is prototype scaffolding and stays out of the repository for now.
# Leading `/`: only the repository roots are content. An unanchored `hardware/`
# would also swallow `i18n/.../hardware/` and `docs/.../hardware/` overlays.
/docs/
/versioned_docs/
/static/
/hardware/
/blog/
/changelog/
/data/
/.content/
/work/
